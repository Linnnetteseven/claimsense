# Backend-only Supabase credentials. Never expose the service role key to React.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Upstash Redis for the hash-chained audit trail. Audit is skipped if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: WHO ICD API credentials for live ICD-11 lookup. Format-only checks if unset.
ICD_API_CLIENT_ID=
ICD_API_CLIENT_SECRET=
ICD_API_RELEASE=2024-01

# SHA eClaims FHIR (UAT defaults). Submission to UAT is not confirmed yet.
SHA_FHIR_URL=https://nshr-uat.sha.go.ke/fhir
SHA_FHIR_TOKEN=
SHA_FHIR_VERIFY_SSL=true
SHA_TERMINOLOGY_BASE=https://nshr-uat.sha.go.ke/fhir
SHA_DIAGNOSIS_SYSTEM=icd11-codes-cs
SHA_BUNDLE_MESSAGE_HEADER=true

# AfyaLink SHR mediator (real claim intake). Credentials are issued to facilities.
AFYALINK_URL=https://uat.dha.go.ke
AFYALINK_USERNAME=
AFYALINK_PASSWORD=
AFYALINK_CONSUMER_KEY=

# Existing integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=10
OPENIMIS_URL=
OPENIMIS_TOKEN=
# Hand-off to the hospital HIS: store (default, HIS pulls) | webhook | openimis
HIS_DELIVERY=store
HIS_WEBHOOK_URL=
HIS_WEBHOOK_TOKEN=

# Browsers allowed to call the API (comma-separated exact origins) and a pattern for preview builds.
CORS_ORIGINS=https://claimsense-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https://claimsense-frontend-[a-z0-9-]+-mugwanjalk-gmailcoms-projects\.vercel\.app$
FRONTEND_URL=claimsense-frontend.vercel.app

# USSD: comma-separated E.164 numbers of registered officers. Empty = anyone (demo only).
USSD_ALLOWED_PHONES=
AT_USERNAME=sandbox
AT_API_KEY=

# Demo: allow POST /claims/{id}/reset and POST /demo/reset. Set false outside demos.
DEMO_RESET_ENABLED=true

DEBUG=true
