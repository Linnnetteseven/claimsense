# Backend-only Supabase credentials. Never expose the service role key to React.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Upstash Redis for the hash-chained audit trail. Audit is skipped if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: WHO ICD API credentials for live ICD-11 lookup. Format-only checks if unset.
ICD_API_CLIENT_ID=
ICD_API_CLIENT_SECRET=
ICD_API_RELEASE=2024-01

# SHA eClaims FHIR (UAT defaults). Submission to UAT is not confirmed yet.
SHA_FHIR_URL=https://nshr-uat.sha.go.ke/fhir
SHA_FHIR_TOKEN=
SHA_FHIR_VERIFY_SSL=true
SHA_TERMINOLOGY_BASE=https://nshr-uat.sha.go.ke/fhir
SHA_DIAGNOSIS_SYSTEM=icd11-codes-cs
SHA_BUNDLE_MESSAGE_HEADER=true

# AfyaLink SHR mediator (real claim intake). Credentials are issued to facilities.
AFYALINK_URL=https://uat.dha.go.ke
AFYALINK_USERNAME=
AFYALINK_PASSWORD=
AFYALINK_CONSUMER_KEY=

# Existing integrations
GEMINI_API_KEY=
OPENIMIS_URL=
OPENIMIS_TOKEN=
# Demo: allow POST /claims/{id}/reset and POST /demo/reset. Set false outside demos.
DEMO_RESET_ENABLED=true

DEBUG=true
