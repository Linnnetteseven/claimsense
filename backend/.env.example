# Hakiki backend configuration. Copy to backend/.env and fill in.
# Never commit .env. Values marked "secret" must not appear in the frontend or in logs.

# --- Database (required) ---------------------------------------------------
# Supabase: Project Settings -> Data API (URL) and -> API Keys (service_role / secret key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # secret; backend only, bypasses row level security

# --- Gemini explanations (optional: without a key, rule advice is shown without AI wording) ---
GEMINI_API_KEY=                     # secret
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=10           # the Gemini API rejects values under 10

# --- Audit chain and shared explanation cache (optional) -------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=           # secret

# --- ICD-11 (optional: offline WHO 2026-01 data is always used; the API adds live lookups) ---
ICD_API_CLIENT_ID=
ICD_API_CLIENT_SECRET=              # secret
ICD_API_RELEASE=2026-01

# --- SHA eClaims FHIR (defaults point at SHA UAT) ---------------------------
SHA_FHIR_URL=https://nshr-uat.sha.go.ke/fhir
SHA_FHIR_TOKEN=                     # secret
SHA_FHIR_VERIFY_SSL=true
SHA_FHIR_TIMEOUT=20
SHA_TERMINOLOGY_BASE=https://nshr-uat.sha.go.ke/fhir
SHA_DIAGNOSIS_SYSTEM=icd11-codes-cs
SHA_BUNDLE_MESSAGE_HEADER=true      # false matches SHA's mediator example (no MessageHeader)

# --- AfyaLink SHR mediator (not used for submission; reserved for registry lookups in the pilot) ---
AFYALINK_URL=https://uat.dha.go.ke
AFYALINK_USERNAME=
AFYALINK_PASSWORD=                  # secret
AFYALINK_CONSUMER_KEY=              # secret

# --- Hand-off to the hospital HIS ------------------------------------------
HIS_DELIVERY=store                  # store (HIS pulls) | webhook | openimis
HIS_WEBHOOK_URL=
HIS_WEBHOOK_TOKEN=                  # secret
OPENIMIS_URL=                       # only for HIS_DELIVERY=openimis
OPENIMIS_TOKEN=                     # secret

# --- Browser access (CORS) --------------------------------------------------
CORS_ORIGINS=https://claimsense-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=^https://claimsense-frontend-[a-z0-9-]+-mugwanjalk-gmailcoms-projects\.vercel\.app$
FRONTEND_URL=claimsense-frontend.vercel.app   # shown in USSD screens and SMS

# --- USSD and SMS (Africa's Talking) ---------------------------------------
USSD_ALLOWED_PHONES=                # comma-separated E.164 numbers; empty = anyone (demo only)
AT_USERNAME=sandbox
AT_API_KEY=                         # secret

# --- Demo and logging -------------------------------------------------------
DEMO_RESET_ENABLED=true             # set false outside demos
DEBUG=false
