[Unit]
Description=Hakiki Claims Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hakiki
Group=hakiki
WorkingDirectory=/opt/hakiki/backend
EnvironmentFile=/etc/hakiki/hakiki.env
ExecStart=/opt/hakiki/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hakiki/evidence_packs

[Install]
WantedBy=multi-user.target
