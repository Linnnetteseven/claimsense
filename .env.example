# Keep the existing demo backend behavior unless you deliberately select Oracle.
DB_BACKEND=redis

# Oracle Autonomous Database wallet connection (python-oracledb Thin mode).
# Put the unzipped wallet in a private local folder outside the repository.
ORACLE_USER=app_user
ORACLE_PASSWORD=replace-with-local-secret
ORACLE_DSN=your_database_low
ORACLE_WALLET_DIR=C:/secure/oracle-wallet
ORACLE_WALLET_PASSWORD=replace-with-wallet-password

# Existing Redis audit-ledger configuration (needed by the migration script).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
