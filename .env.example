# Keep the existing demo backend behavior unless you deliberately select Oracle.
DB_BACKEND=redis
DEPARTMENTS_ENABLED=true

# Oracle Autonomous Database (python-oracledb Thin mode).
ORACLE_USER=HAKIKI_APP
ORACLE_PASSWORD=replace-with-local-secret
# Walletless TLS: set ORACLE_DSN to the TLS connection string from OCI and leave
# both wallet variables blank. The ADB must allow TLS and your client IP must be
# allowed by its network access rules.
ORACLE_DSN=replace-with-TLS-connection-string
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=
# Wallet mTLS: instead set ORACLE_DSN to a TNS alias from tnsnames.ora,
# ORACLE_WALLET_DIR to the unzipped wallet folder, and ORACLE_WALLET_PASSWORD
# to the password used when downloading the wallet.

# Existing Redis audit-ledger configuration (needed by the migration script).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Synthetic evidence exports are local by default. OCI upload is currently disabled.
EVIDENCE_STORAGE=local
EVIDENCE_DIR=./evidence_packs

# Experimental Oracle Select AI. Requires a separate view-only DB user and a
# Select AI profile configured in Oracle; disabled unless explicitly true.
ENABLE_SELECT_AI=false
ORACLE_SELECT_AI_USER=HAKIKI_ANALYTICS
ORACLE_SELECT_AI_PASSWORD=replace-with-local-secret
